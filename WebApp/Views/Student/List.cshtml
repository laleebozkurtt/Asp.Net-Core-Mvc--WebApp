@model IEnumerable<StudentModel>

@{
	ViewData["Title"] = "Participation List";
	Layout = "_Layout";

}


<div class="col-lg-12 grid-margin stretch-card">
	<div class="card">
		<div class="card-header">
			<h2 class="card-title fw-bold">Öğrenci Listesi</h2>
			<div class="card-toolbar">

				<a asp-controller="Student" asp-action="Detail" class="btn btn-inverse-info btn-fw"> <i class="ti-plus"></i> Add </a>

			</div>
		</div>
		<div class="card-body">

			<div class="table-responsive">
				<table class="table table-hover">
					<thead>
						<tr>
							<th>Name</th>
							<th>Email</th>
							<th>Phone</th>
							<th>Participation</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						@if (Model != null && Model.Any())
						{
							foreach (var student in Model)
							{
								<tr>
									<td>@student.Name</td>
									<td>@student.Email</td>
									<td>@student.Phone</td>
									<td>
										<input type="checkbox" checked="@(student.WillAttend == 1)" onclick="return false;" />
									<td>
										<a asp-controller="Student" asp-action="Detail" asp-route-id="@student.Id" class="btn btn-warning btn-sm">
											Düzenle
										</a>
										<!-- Sil Butonu -->
										<button type="button" class="btn btn-danger btn-sm" onclick="confirmDelete('@student.Id')">
											Sil
										</button>

										
									</td>
								</tr>
							}
						}
						else
						{
							<tr>
								<td colspan="5" class="text-center">There is no student record.</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
<!-- SweetAlert2 Kütüphanesini Dahil Et -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<<script>
	 function confirmDelete(studentId) {
		 const swalWithBootstrapButtons = Swal.mixin({
			 customClass: {
				 confirmButton: "btn btn-success",
				 cancelButton: "btn btn-danger"
			 },
			 buttonsStyling: false
		 });
		 swalWithBootstrapButtons.fire({
			 title: "Are you sure?",
			 text: "You won't be able to revert this!",
			 icon: "warning",
			 showCancelButton: true,
			 confirmButtonText: "Yes, delete it!",
			 cancelButtonText: "No, cancel!",
			 reverseButtons: true
		 }).then((result) => {
			 if (result.isConfirmed) {

				 // AJAX İsteği Gönderme
				 $.ajax({
					 url: "/Student/Delete",  // Silme isteğini göndereceğimiz URL
					 type: "POST",
					 data: { id: studentId },  // Gönderilecek veri
					 success: function (response) {
						 if (response.success) {
							 // Silme başarılıysa tablo satırını kaldır
							 $("#row-" + studentId).remove();

							 // Başarı mesajı göster
							 swalWithBootstrapButtons.fire({
								 title: "Deleted!",
								 text: response.message,
								 icon: "success"
							 });
						 } else {
							 // Hata mesajı göster
							 swalWithBootstrapButtons.fire({
								 title: "Error!",
								 text: response.message,
								 icon: "error"
							 });
						 }
					 },
					 error: function () {
						 swalWithBootstrapButtons.fire({
							 title: "Error!",
							 text: "An error occurred while deleting the record.",
							 icon: "error"
						 });
					 }
				 });
			 }
		 });
	 }
</script>

